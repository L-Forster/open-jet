include megakernel/pyproject.toml megakernel/LICENSE
include megakernel/__init__.py megakernel/__main__.py
recursive-include megakernel/server *.py
include megakernel/legacy/Makefile megakernel/legacy/README.md megakernel/legacy/draft_vocab_32k.bin
recursive-include megakernel/legacy/server *.py
