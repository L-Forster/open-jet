{
  "name": "@openjet/tui",
  "version": "0.4.31",
  "private": true,
  "type": "module",
  "bin": {
    "openjet-tui": "dist/index.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "generate:protocol": "node scripts/generate-protocol-types.mjs",
    "build": "npm run generate:protocol && tsc -p tsconfig.json",
    "build:binary": "npm run build && bun build --compile ./dist/index.js --outfile ./dist/openjet-tui",
    "test": "vitest --run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@mariozechner/clipboard": "0.3.9",
    "chalk": "5.6.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "bun": "1.3.10",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
